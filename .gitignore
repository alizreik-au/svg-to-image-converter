# ---- Rust / Cargo ----
# Build output. Note: Cargo.lock IS committed (this is a binary application).
/target/
**/*.rs.bk

# Debug symbols / compiler artifacts
*.pdb

# ---- Windows packaging & signing artifacts ----
# Generated by scripts/build-installer.ps1 and build-sparse-package.ps1
# (these normally land in target/, but ignore them anywhere to be safe).
*.msix
*.msixbundle
*.appx
*.appxbundle

# Code-signing material — NEVER commit private keys.
*.pfx
*.p12
*.snk

# Diagnostic logs (see scripts/diagnose.ps1)
*.log
diagnostics.on

# ---- Environment & secrets ----
.env
.env.*
!.env.example

# ---- Editors / IDEs ----
.vscode/
.idea/
*.iml
*.user
*.suo
*.swp
*~

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini
